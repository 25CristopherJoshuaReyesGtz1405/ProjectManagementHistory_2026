# Configuración del Servidor
PORT=3000
CORS_ORIGINS=http://localhost:4200

# Motor Transaccional PostgreSQL 15
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_seguro
DB_NAME=sigah_itd

# Motor de Colas Asíncronas Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Bóvedas de Almacenamiento Local y Nube Híbrida
STORAGE_TEMP_PATH=temp_uploads
STORAGE_HOT_PATH=boveda_local_itd
STORAGE_COLD_PATH=boveda_fria_itd
FIREBASE_CREDENTIALS_PATH=./src/AutenticacionActiva/ConfiguracionActiva/FirebaseServiceAccount.json
GOOGLE_DRIVE_CREDENTIALS_PATH=./src/AutenticacionActiva/ConfiguracionActiva/FirebaseServiceAccount.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=tu_folder_id_de_drive

# Criptografía y Servicios Externos
SIGAH_CRYPTO_SECRET=CAMBIAR_POR_SEMILLA_SHA256_INSTITUCIONAL
SIGAH_PRIVATE_KEY=LLAVE_NO_CONFIGURADA
VERIFICAMEX_API_KEY=