# =========================================================================
# ETAPA 1: BUILDER (Compilación TypeScript ESM con Heap extendido a 4GB)
# =========================================================================
FROM node:22-alpine AS builder

WORKDIR /usr/src/app

# Ampliamos el límite de memoria V8 a 4 GB para evitar OOM al compilar googleapis
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm install

COPY tsconfig*.json nest-cli.json ./
COPY src ./src

# Compilamos omitiendo el chequeo pesado de .d.ts externos en node_modules
RUN npx tsc -p tsconfig.build.json --skipLibCheck --incremental false

# =========================================================================
# ETAPA 2: RUNNER (Imagen de producción ligera y endurecida)
# =========================================================================
FROM node:22-alpine AS runner

WORKDIR /usr/src/app

ENV NODE_ENV=production
ENV PORT=3000

RUN mkdir -p boveda_local_itd boveda_fria_itd temp_uploads secrets && \
    chown -R node:node /usr/src/app

COPY --from=builder --chown=node:node /usr/src/app/package*.json ./
COPY --from=builder --chown=node:node /usr/src/app/node_modules ./node_modules
COPY --from=builder --chown=node:node /usr/src/app/dist ./dist

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/v3/soporte/salud-nodos || exit 1

CMD ["node", "dist/main.js"]